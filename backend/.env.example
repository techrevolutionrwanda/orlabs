PORT=5000
MONGODB_URI=mongodb://localhost:27017/orlabs
# Used once to create the initial admin account; update credentials in the portal after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-password-of-at-least-12-characters
# Must exactly match frontend PORTAL_SESSION_SECRET. Generate with `openssl rand -hex 32`.
PORTAL_SESSION_SECRET=generate-and-copy-the-same-secret-to-both-apps-32chars
