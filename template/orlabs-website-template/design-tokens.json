{
  "$description": "OrLabs Tech Industries design tokens v1. Source of truth for colors, type, radius and spacing. Mirrors the :root block in index.html.",
  "color": {
    "navy":          { "value": "#0B1F3A", "use": "Primary brand color. Dark sections, header, headings on light backgrounds." },
    "navy-deep":     { "value": "#071628", "use": "Footer background." },
    "navy-line":     { "value": "#22406A", "use": "Borders and dividers on navy." },
    "gold":          { "value": "#F5B301", "use": "Accent: primary buttons, highlights, the 'Or' in the logo. Never for body text on white." },
    "gold-hover":    { "value": "#FFC21F", "use": "Primary button hover." },
    "teal":          { "value": "#00A6A6", "use": "Secondary accent for decoration (dots, icons on navy). Not for text on light backgrounds." },
    "teal-text":     { "value": "#007C7C", "use": "Teal for small text on light backgrounds (passes 4.5:1)." },
    "bg":            { "value": "#F7F8FA", "use": "Page background." },
    "surface":       { "value": "#FFFFFF", "use": "Cards and light sections." },
    "chip":          { "value": "#EEF2F7", "use": "Tag / chip background." },
    "border":        { "value": "#E3E7ED", "use": "Card and section borders on light." },
    "text":          { "value": "#2B2F36", "use": "Body text on light." },
    "text-muted":    { "value": "#4A515C", "use": "Secondary text on light." },
    "text-subtle":   { "value": "#5A6270", "use": "Labels and captions on light." },
    "on-navy":       { "value": "#FFFFFF", "use": "Headings and text on navy." },
    "on-navy-muted": { "value": "#C9D3E0", "use": "Body text on navy." }
  },
  "font": {
    "display": { "value": "Sora", "weights": [600, 700], "source": "Google Fonts", "use": "Headings, step numbers, quotes, logo wordmark on the web." },
    "body":    { "value": "Inter", "weights": [400, 500, 600], "source": "Google Fonts", "use": "Body copy, navigation, buttons, forms." }
  },
  "fontSize": {
    "hero":    "clamp(2.5rem, 5vw + 1rem, 3.75rem)",
    "h2":      "clamp(1.875rem, 2.5vw + 1rem, 2.5rem)",
    "h3":      "1.25rem",
    "lead":    "1.1875rem",
    "body":    "1rem",
    "small":   "0.875rem",
    "eyebrow": "0.8125rem (uppercase, letter-spacing 0.16em, weight 600)"
  },
  "radius": { "sm": "12px", "md": "18px", "lg": "28px", "pill": "999px" },
  "space": { "section": "clamp(4rem, 8vw, 6rem)", "gutter": "24px", "container": "1200px" },
  "breakpoints": { "nav-collapse": "860px", "stack-columns": "900px" }
}
