# URL that receives the landing page contact form POST.
# Until this is set, the form shows a "not connected yet" message.
NEXT_PUBLIC_FORM_ENDPOINT=

# Public site URL — used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret that signs the portal session cookie.
# Change it in every environment that is not a local build.
PORTAL_SESSION_SECRET=change-me-in-every-real-environment
