# URL that receives the landing page contact form POST.
# Until this is set, the form shows a "not connected yet" message.
NEXT_PUBLIC_FORM_ENDPOINT=

# Public site URL — used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API URL used by the portal sign-in and account settings server actions.
ORLABS_API_URL=http://localhost:5000

# Must exactly match backend PORTAL_SESSION_SECRET. Generate a random value with `openssl rand -hex 32`.
PORTAL_SESSION_SECRET=generate-and-copy-the-same-secret-to-both-apps-32chars
